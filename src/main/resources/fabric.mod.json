{
  "schemaVersion": 1,
  "id": "elytrapro",
  "version": "${version}",
  "name": "ElytraPro",
  "description": "Auto Elytra and Auto Firework for Minecraft 1.21 and 1.21.1. Client-side only.",
  "authors": ["ElytraPro contributors"],
  "license": "MIT",
  "icon": "assets/elytrapro/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.elytrapro.client.ElytraProClient"]
  },
  "mixins": ["elytrapro.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21 <=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
